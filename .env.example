# ─── Database ───────────────────────────────────────────────────
# For Docker: use postgres hostname. For local dev: use localhost.
DATABASE_URL=postgresql+asyncpg://finpilot:finpilot@localhost:5432/finpilot
POSTGRES_PASSWORD=finpilot

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ───────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-35-plus-random-characters
JWT_SECRET_KEY=change-me-to-35-plus-random-characters

# ─── AI Providers ───────────────────────────────────────────────
PAWA_API_KEY=
PAWA_API_URL=https://api.pawa.ai
GEMINI_API_KEY=

# ─── Cloudflare R2 (document storage) ──────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=finpilot-documents

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
